# ─────────────────────────────────────────────────────────────────────────────
# Internship Outreach Manager — environment settings (copy to .env)
# Placeholders only. Never commit a real .env. Secrets stay server-side.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection used by BOTH the web app and the worker.
#  Docker Compose:        postgres://outreach:outreach@localhost:5432/outreach
#  Native PostgreSQL:     postgres://USER:PASSWORD@localhost:5432/outreach
#  Embedded (demo/dev):   postgres://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable   (npm run db:local)
DATABASE_URL=postgres://outreach:outreach@localhost:5432/outreach
# "require" for managed cloud databases that need TLS.
DATABASE_SSL=
DATABASE_POOL_MAX=5

# Public URL of the web app (used for OAuth redirects). Local: http://localhost:3000
APP_BASE_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts mailbox tokens and API keys at rest.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it OUTSIDE the database (env var / secret manager). Losing it makes stored tokens unusable.
APP_ENCRYPTION_KEY=
# Optional: previous key during rotation (decrypt falls back to it).
APP_ENCRYPTION_KEY_PREVIOUS=

# ── Demo mode ───────────────────────────────────────────────────────────────
# 1 = demo mode: mock mailbox/Apollo/AI only, simulated clock controls, never sends or spends credits.
DEMO_MODE=0
# Used by `npm run seed:demo` to create a demo owner if none exists (choose your own, 12+ chars).
DEMO_OWNER_EMAIL=demo-owner@example.test
DEMO_PASSWORD=

# ── Microsoft Graph / Outlook (see docs/OUTLOOK.md) ─────────────────────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Must exactly match a redirect URI registered in Entra ID.
MS_REDIRECT_URI=http://localhost:3000/api/oauth/microsoft/callback
# common (personal + work/school), consumers (personal only), organizations, or a tenant ID.
MS_TENANT=common

# Cloud webhook mode: requires a public HTTPS URL that Microsoft can reach.
# Leave WEBHOOKS_ENABLED=0 locally — the worker polls instead.
WEBHOOKS_ENABLED=0
PUBLIC_BASE_URL=
# Polling interval (minutes). Defaults: 5 without webhooks, 30 (safety net) with webhooks.
SYNC_POLL_MINUTES=

# ── Apollo ──────────────────────────────────────────────────────────────────
# The API key is entered in Settings (stored encrypted). Set to "mock" to force the mock adapter in development.
APOLLO_MODE=

# ── AI providers (optional; keys entered in Settings, stored encrypted) ────
# anthropic | openai
AI_DEFAULT_PROVIDER=anthropic
# Override the Anthropic model (default claude-opus-5-5). OpenAI needs a model set here or in Settings.
AI_ANTHROPIC_MODEL=
AI_OPENAI_MODEL=
# "mock" forces the deterministic mock AI.
AI_MODE=

# ── Map tiles and geocoding (separate services) ─────────────────────────────
# Any MapLibre style URL; default OpenFreeMap "liberty" (no key; attribution required).
MAP_STYLE_URL=
MAP_ATTRIBUTION=
# none | nominatim. Public Nominatim: max 1 request/second, identify your app, attribution required.
GEOCODER=none
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=InternshipOutreachManager/0.1 (self-hosted)
GEOCODER_MIN_INTERVAL_MS=1100

# ── File storage for CVs and uploaded imports ───────────────────────────────
# local (default; STORAGE_DIR on a private volume) or s3 (any S3-compatible private bucket).
STORAGE_DRIVER=local
STORAGE_DIR=./data/files
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Worker ──────────────────────────────────────────────────────────────────
WORKER_TICK_MS=5000
