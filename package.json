{
  "name": "internship-outreach-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "worker": "tsx src/worker/index.ts",
    "db:local": "tsx scripts/local-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "node scripts/copy-vendor.mjs",
    "prebuild": "node scripts/copy-vendor.mjs && node scripts/make-icons.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@electric-sql/pglite": "0.5.17",
    "@electric-sql/pglite-socket": "0.2.20",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3",
    "luxon": "3.7.2",
    "maplibre-gl": "6.19.0",
    "next": "16.4.6",
    "openai": "^7.62.0",
    "papaparse": "5.7.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.2",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
